# Copy to backend/.env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
# Comma-separated list of allowed browser origins (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Backend only. Bypasses Row Level Security — never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Credit Assistant section ---
OPENAI_API_KEY=

# --- Card Storage section (Plaid sandbox) ---
# Keys from https://dashboard.plaid.com/team/keys (Sandbox tab).
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" or "production". Keep sandbox for the hackathon.
PLAID_ENV=sandbox
# Sandbox institution used by POST /api/v1/card-storage/plaid/sync when no
# access token is supplied. ins_56 (Chase) has a credit card with liabilities.
PLAID_SANDBOX_INSTITUTION_ID=ins_56
# Optional: reuse an existing sandbox Item instead of creating a new one.
PLAID_ACCESS_TOKEN=
