# Copy to `.env.local` and adjust. Nothing here is secret except the Supabase anon
# key, which is public by design (it is the browser key). Never put the service-role
# key in the frontend.

# FastAPI backend (see backend/README.md).
# Local: the uvicorn dev server. On Vercel leave this unset — the app falls back
# to the same-origin `/api/v1`, which the root `vercel.json` rewrites to the
# `backend` service. If you do set it there, use `/api/v1`; a specific hostname
# breaks preview deployments. NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Supabase project (Auth only — data goes through the backend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Seeded demo account (backend/scripts/seed_demo.py)
NEXT_PUBLIC_DEMO_EMAIL=demo@demo.com
NEXT_PUBLIC_DEMO_PASSWORD=demo123!
